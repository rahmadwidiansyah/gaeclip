# Model binaries via Git LFS (butuh `git lfs install` sekali per mesin).
# File-file ini di-force-add karena /models/* di-ignore di .gitignore.
models/**/*.pt filter=lfs diff=lfs merge=lfs -text
models/**/*.tflite filter=lfs diff=lfs merge=lfs -text
models/**/*.model filter=lfs diff=lfs merge=lfs -text
models/**/*.onnx filter=lfs diff=lfs merge=lfs -text
models/**/*.bin filter=lfs diff=lfs merge=lfs -text
