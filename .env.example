# ============================================================================
# Gaeclip environment template
#
# Two configuration kinds (see Settings UI > Configuration):
#
#   1. INFRASTRUCTURE (below, REQUIRED)
#      Read at startup only. Never editable from the Web UI.
#      Changing these needs a container restart/rebuild.
#
#   2. APPLICATION SEED (optional, first boot only)
#      Used ONCE to seed the database when a setting has no stored value.
#      Afterwards the database wins: DB value > ENV fallback > default.
#      Prefer managing these via Settings UI > Configuration instead.
# ============================================================================

# --- 1. INFRASTRUCTURE (required) -------------------------------------------
REDIS_URL=redis://redis:6379/0
STORAGE_ROOT=/app/storage
API_HOST=127.0.0.1
API_PORT=8000
NEXT_PUBLIC_API_BASE_URL=https://api-gaeclip.sanding.online
FRONTEND_ORIGINS=http://127.0.0.1:4113,http://localhost:4113,http://192.168.1.85:4113,https://gaeclip.sanding.online
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
PUBLIC_MODE=false
# Bearer token for the API. Required when PUBLIC_MODE=true (public bind /
# Cloudflare Tunnel). Leave empty for desktop and loopback-only use.
# Send it as "Authorization: Bearer <token>" or "X-API-Key: <token>";
# the Settings UI has a matching "API access token" field.
API_AUTH_TOKEN=

# Deployment secret used to encrypt stored secrets (e.g. Gemini API key).
# Optional but recommended: without it a key file is generated inside
# STORAGE_ROOT on first boot. Never commit a real value here.
SETTINGS_SECRET=

# --- 2. APPLICATION SEED (optional, first boot only) ------------------------
# Safe to leave unset: built-in defaults apply and everything below can be
# changed later via Settings UI > Configuration (persisted in database).
# NOTE: GEMINI_API_KEY is the only seed worth setting here when the
# database is empty; it is migrated once and never written back to this file.

#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash
#GEMINI_TIMEOUT_SECONDS=300
# Provider pool tuning (all optional; UI Settings overrides these):
#GEMINI_MAX_ATTEMPTS=9
#GEMINI_RETRY_MAX_ATTEMPTS=2
#GEMINI_RETRY_BASE_DELAY_MS=500
#GEMINI_RETRY_MAX_DELAY_MS=5000
#GEMINI_REQUEST_TIMEOUT_MS=30000
#GEMINI_CIRCUIT_FAILURE_THRESHOLD=3
#GEMINI_CIRCUIT_COOLDOWN_MS=30000
#GEMINI_MAX_CONCURRENT_PER_PROVIDER=2
#GEMINI_ROUTING_STRATEGY=priority
# NOTE: multiple API keys are managed in Settings UI > Gemini Providers
# (redundancy + routing — not promised quota multiplication; separate
# Google Cloud/AI projects may be needed for independent quota).
#WHISPER_MODEL=small
#TRANSCRIPT_SOURCE=youtube_first
#LOG_LEVEL=INFO
#WORKER_CONCURRENCY=1
#MAX_SOURCE_DURATION_SECONDS=7200
# Path (inside containers: mount it) to a Netscape cookies.txt exported
# from a logged-in YouTube browser session. Only needed when YouTube
# answers 429 / "Sign in to confirm you're not a bot".
#YTDLP_COOKIES_FILE=/app/storage/cookies.txt
#MAX_CLIPS=3
#MIN_CLIP_DURATION_SECONDS=30
#MAX_CLIP_DURATION_SECONDS=60
#CLIP_BUFFER_SECONDS=1.5
#MAX_TRANSCRIPT_CHARS=1000000
#MAX_ARTIFACT_BYTES=524288000
#MAX_JOB_SECONDS=3600
#MAX_LLM_OUTPUT_TOKENS=4096
#MAX_LLM_INPUT_CHARS=120000
#MAX_CONCURRENT_JOBS=1
#ARTIFACT_RETENTION_HOURS=24
#INTERMEDIATE_RETENTION_HOURS=6

# --- 3. DISTRIBUTION (docker-compose.prod.yml only, optional) ----------------
# Which GHCR release to run. Default is latest; pin a version for stability.
# Available tags: latest, 1.2.3, 1.2, 1, sha-<commit> (see GitHub Releases).
#GAECLIP_VERSION=latest
# Image namespace (fork users: set this to your own GHCR owner).
#GHCR_OWNER=rahmadwidiansyah
